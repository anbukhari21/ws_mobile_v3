map_server:
  ros__parameters:
    use_sim_time: false
    yaml_filename: /home/abdulrahman/maps/my_map.yaml
    topic_name: map
    frame_id: map

amcl:
  ros__parameters:
    use_sim_time: false
    global_frame_id: map
    odom_frame_id: odom
    base_frame_id: base_footprint
    scan_topic: /scan
    # Do not override robot_model_type/laser_model_type here. The V2 Humble
    # AMCL process crashed after global reinitialization with the full old
    # ws_mobile plugin overrides, while the default plugins stayed stable.
    max_beams: 60
    laser_max_range: 12.0
    laser_min_range: 0.0
    min_particles: 500
    max_particles: 5000
    update_min_d: 0.05
    update_min_a: 0.05
    resample_interval: 1
    recovery_alpha_slow: 0.001
    recovery_alpha_fast: 0.1
    alpha1: 0.2
    alpha2: 0.2
    alpha3: 0.2
    alpha4: 0.2
    alpha5: 0.2
    tf_broadcast: true
    transform_tolerance: 1.0
    set_initial_pose: false
    save_pose_rate: 0.5
    first_map_only: false
    always_reset_initial_pose: false

lifecycle_manager_path_v2_localization:
  ros__parameters:
    use_sim_time: false
    autostart: true
    node_names:
      - map_server
      - amcl
